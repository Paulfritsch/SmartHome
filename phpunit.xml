<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <!-- Unit-Tests: einzelne Klassen ohne Datenbank -->
        <testsuite name="Unit">
            <file>tests/DashboardTest.php</file>
            <file>tests/DeviceTest.php</file>
            <file>tests/EnergyMonitorTest.php</file>
            <file>tests/SavingsCalculatorTest.php</file>
            <file>tests/ScheduleTest.php</file>
            <file>tests/SubscriptionTest.php</file>
        </testsuite>
        <!-- Integrationstests: Repositories zusammen mit einer echten SQLite-Datenbank (im Arbeitsspeicher) -->
        <testsuite name="Integration">
            <file>tests/BookingRepositoryTest.php</file>
            <file>tests/DeviceRepositoryTest.php</file>
            <file>tests/DeviceScheduleTest.php</file>
            <file>tests/OrderRepositoryTest.php</file>
            <file>tests/RoomRepositoryTest.php</file>
            <file>tests/UserRepositoryTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>prototype/src</directory>
        </include>
    </source>
</phpunit>